  "interactions": [
    {
      "description": "a request for a page of users",
      "pending": false,
      "providerStates": [
        {
          "name": "users exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/v1/users",
        "query": {
          "page": [
            "1"
          ],
          "perPage": [
            "10"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "users": [
              {
                "createdAt": "2026-11-01T12:00:00.123456",
                "email": "ada@example.test",
                "id": 0,
                "name": "Ada Lovelace"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "matchingRules": {
          "body": {
            "$.users": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.users[*].*": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.users[*].createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.users[*].email": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.users[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.users[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
